# PostgreSQL — conexão principal
DATABASE_URL=postgresql://postgres:password@localhost:5432/layoutbank

# Next.js
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Parsing
MAX_FILE_SIZE_MB=10
LAYOUT_CACHE_TTL_SECONDS=300
